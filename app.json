{
  "expo": {
    "name": "verseVIO Remote",
    "slug": "versecue-remote",
    "version": "1.2.1",
    "orientation": "landscape",
    "icon": "./assets/versecue-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.versecue.remote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your verseVIO desktop on the same local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSBonjourServices": [
          "_versecue._tcp"
        ]
      },
      "buildNumber": "7",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.versecue.remote",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_LOCAL_NETWORK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/versecue-logo.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR displayed in verseVIO desktop settings.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "./plugins/withLocalRemoteNetwork.cjs",
      "./plugins/withWindowsBuildPaths.cjs",
      "expo-router",
      "./plugins/withDirectLanDns.cjs"
    ],
    "scheme": "versecue-remote",
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://verse-cue-web.vercel.app/api/updates/mobile",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./assets/update-certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
