{
  "expo": {
    "name": "VerseCue Remote",
    "slug": "versecue-remote",
    "version": "1.1.3",
    "orientation": "landscape",
    "icon": "./assets/versecue-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.versecue.remote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your VerseCue desktop on the same local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSBonjourServices": [
          "_versecue._tcp"
        ]
      },
      "buildNumber": "5",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.versecue.remote",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_LOCAL_NETWORK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/versecue-logo.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR displayed in VerseCue desktop settings.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "./plugins/withLocalRemoteNetwork.cjs",
      "./plugins/withWindowsBuildPaths.cjs",
      "expo-router",
      "./plugins/withDirectLanDns.cjs"
    ],
    "scheme": "versecue-remote",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
